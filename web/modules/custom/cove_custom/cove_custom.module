<?php

/**
 * @file
 * Site-wide custom hooks for COVE that don't belong to a domain-specific module.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\file\FileInterface;
use Drupal\node\NodeInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_query_alter().
 *
 * Pin parent content types (Timeline, Map, Gallery Exhibit, Blog) above their
 * children in cove_og_content.
 */
function cove_custom_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'cove_og_content' || !$query instanceof Sql) {
    return;
  }

  // NULL table makes Views compile this as a SQL expression.
  $query->addField(NULL, "CASE WHEN node_field_data.type IN ('chronology', 'map', 'galler_exhibit', 'blog') THEN 0 ELSE 1 END", 'cove_pin_shared');
  $query->addOrderBy(NULL, NULL, 'ASC', 'cove_pin_shared');

  // Prepend so this sort beats the existing 'created' DESC.
  $last = array_pop($query->orderby);
  array_unshift($query->orderby, $last);
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 *
 * Hides field_featured_in_exhibit when creating a gallery_image from an
 * exhibit context, CER fills it on the exhibit's own save.
 */
function cove_custom_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface $form_state): void {
  if (($entity_form['#entity_type'] ?? '') !== 'node'
    || ($entity_form['#bundle'] ?? '') !== 'gallery_image'
    || ($entity_form['#op'] ?? '') !== 'add') {
    return;
  }

  if (_cove_custom_resolve_exhibit_from_request() === NULL) {
    return;
  }

  if (isset($entity_form['field_featured_in_exhibit'])) {
    $entity_form['field_featured_in_exhibit']['#access'] = FALSE;
  }
}

/**
 * Image fields per bundle, mapped to the styles they display with.
 *
 * Drupal builds derivatives lazily on first request, so images can render
 * broken right after upload. We pre-build them on save. Add an entry
 * when a new content type starts displaying images.
 */
const COVE_CUSTOM_PREBUILD_STYLES = [
  'gallery_image' => [
    'field_galleryimage' => ['gallery_for_exhibits', 'gallery_home', 'gallery_zoom', 'thumbnail'],
  ],
  'chronology_entry' => [
    'field_image' => ['gallery_zoom'],
  ],
  'article' => [
    'field_image' => ['large', 'medium'],
  ],
  'contributor' => [
    'field_profile_picture' => ['medium', 'thumbnail'],
  ],
  'galler_exhibit' => [
    'field_exhibit_icon' => ['thumbnail'],
  ],
  'editions_index_page' => [
    'field_index_banner' => ['cke_media_resize_large', 'front_thumbnail', 'index_banner', 'wide'],
    'field_icon' => ['40px_icon'],
  ],
];

/**
 * Implements hook_ENTITY_TYPE_insert() for nodes.
 */
function cove_custom_node_insert(NodeInterface $node): void {
  _cove_custom_prebuild_image_derivatives($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for nodes.
 */
function cove_custom_node_update(NodeInterface $node): void {
  _cove_custom_prebuild_image_derivatives($node);
}

/**
 * Pre-builds the derivatives a node's images are displayed with, on save.
 *
 * @see COVE_CUSTOM_PREBUILD_STYLES
 */
function _cove_custom_prebuild_image_derivatives(NodeInterface $node): void {
  $field_map = COVE_CUSTOM_PREBUILD_STYLES[$node->bundle()] ?? NULL;
  if ($field_map === NULL) {
    return;
  }

  $logger = \Drupal::logger('cove_custom');
  $style_storage = \Drupal::entityTypeManager()->getStorage('image_style');

  foreach ($field_map as $field_name => $style_ids) {
    if (!$node->hasField($field_name)) {
      continue;
    }
    $field = $node->get($field_name);
    if ($field->getFieldDefinition()->getType() !== 'image' || $field->isEmpty()) {
      continue;
    }

    $styles = $style_storage->loadMultiple($style_ids);
    $missing = array_diff($style_ids, array_keys($styles));
    if ($missing !== []) {
      $logger->warning('Unknown image style(s) to pre-build: @ids.', ['@ids' => implode(', ', $missing)]);
    }

    foreach ($field->referencedEntities() as $file) {
      if (!$file instanceof FileInterface) {
        continue;
      }
      $source = $file->getFileUri();
      if (!file_exists($source)) {
        $logger->warning('Source image not found for node @nid: @uri.', ['@nid' => $node->id(), '@uri' => $source]);
        continue;
      }

      foreach ($styles as $style) {
        $destination = $style->buildUri($source);
        if (file_exists($destination)) {
          continue;
        }
        try {
          if (!$style->createDerivative($source, $destination)) {
            $logger->warning('Could not build the @style derivative of @uri.', ['@style' => $style->id(), '@uri' => $source]);
          }
        }
        catch (\Throwable $e) {
          // Image processing must never break saving content.
          $logger->error('Building the @style derivative of @uri failed: @message', [
            '@style' => $style->id(),
            '@uri' => $source,
            '@message' => $e->getMessage(),
          ]);
        }
      }
    }
  }
}

/**
 * Resolves the parent exhibit nid from routeMatch, then from entity_browser's
 * `original_path` query param (set on the modal iframe).
 */
function _cove_custom_resolve_exhibit_from_request(): ?int {
  $exhibit = \Drupal::routeMatch()->getParameter('node');
  if ($exhibit instanceof NodeInterface && $exhibit->bundle() === 'galler_exhibit' && $exhibit->access('view')) {
    return (int) $exhibit->id();
  }

  $original_path = \Drupal::request()->query->get('original_path');
  if (!is_string($original_path) || $original_path === '') {
    return NULL;
  }

  if (!preg_match('#^/node/(\d+)(?:/edit)?$#', $original_path, $matches)) {
    return NULL;
  }

  $node = \Drupal::entityTypeManager()->getStorage('node')->load((int) $matches[1]);
  if (!$node instanceof NodeInterface || $node->bundle() !== 'galler_exhibit' || !$node->access('view')) {
    return NULL;
  }

  return (int) $node->id();
}
